
@article{nazer_computation_2007,
	title = {Computation Over Multiple-Access Channels},
	volume = {53},
	rights = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/{IEEE}.html},
	issn = {0018-9448},
	url = {http://ieeexplore.ieee.org/document/4305404/},
	doi = {10.1109/TIT.2007.904785},
	abstract = {The problem of reliably reconstructing a function of sources over a multiple-access channel ({MAC}) is considered. It is shown that there is no source–channel separation theorem even when the individual sources are independent. Joint source–channel strategies are developed that are optimal when the structure of the channel probability transition matrix and the function are appropriately matched. Even when the channel and function are mismatched, these computation codes often outperform separation-based strategies. Achievable distortions are given for the distributed reﬁnement of the sum of Gaussian sources over a Gaussian multiple-access channel with a joint source–channel lattice code. Finally, computation codes are used to determine the multicast capacity of ﬁnite-ﬁeld multiple-access networks, thus linking them to network coding.},
	pages = {3498--3516},
	number = {10},
	journaltitle = {{IEEE} Transactions on Information Theory},
	shortjournal = {{IEEE} Trans. Inform. Theory},
	author = {Nazer, B.. and Gastpar, M..},
	urldate = {2026-02-27},
	date = {2007-10},
	langid = {english},
	file = {PDF:C\:\\Users\\mark\\Zotero\\storage\\8M2I87QL\\Nazer and Gastpar - 2007 - Computation Over Multiple-Access Channels.pdf:application/pdf},
}

