	langid = {english},
	file = {PDF:C\:\\Users\\mark\\Zotero\\storage\\NBSVBLFT\\Kim et al. - 2020 - Two-Layer Nonlinear FIR Filter and Unscented Kalman Filter Fusion With Application to Mobile Robot L.pdf:application/pdf},
