	langid = {english},
	file = {PDF:C\:\\Users\\mark\\Zotero\\storage\\U3EMN8KJ\\Goldenbaum et al. - 2013 - Harnessing Interference for Analog Function Computation in Wireless Sensor Networks.pdf:application/pdf},
}

