@inproceedings{huang_interference_2024,
	location = {Denver, {CO}, {USA}},
	title = {Interference Cancellation for {OTFS}-Based Over-the-Air Computation},
	rights = {https://doi.org/10.15223/policy-029},
	isbn = {979-8-3503-0405-3},
